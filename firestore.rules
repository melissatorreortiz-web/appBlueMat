rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================
    // FUNCIONES DE APOYO
    // =========================

    function usuarioActivo() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.activo == true;
    }

    function rolUsuario() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data.rol;
    }

    function esAdmin() {
      return usuarioActivo()
        && rolUsuario() == "admin";
    }

    function esAdminORecepcion() {
      return usuarioActivo()
        && rolUsuario() in ["admin", "recepcion"];
    }

    function esProfesor() {
      return usuarioActivo()
        && rolUsuario() == "profesor";
    }


    // =========================
    // USUARIOS
    // =========================

    match /usuarios/{usuarioId} {

      // Cada quien puede leer su propio perfil,
      // y un admin puede leer todos.
      allow read: if request.auth != null
                   && (
                     request.auth.uid == usuarioId
                     || esAdmin()
                   );

      // Solo un administrador activo puede
      // crear, modificar o eliminar usuarios.
      allow write: if esAdmin();
    }


    // =========================
    // ALUMNOS
    // =========================

    match /alumnos/{alumnoId} {

      // Cualquier usuario activo puede ver alumnos.
      allow read: if usuarioActivo();

      // Solo admin y recepción pueden crear/editar alumnos.
      allow write: if esAdminORecepcion();
    }


    // =========================
    // TARIFAS
    // =========================

    match /tarifas/{tarifaId} {

      allow read: if usuarioActivo();

      // Solo admin puede tocar tarifas.
      allow write: if esAdmin();
    }


    // =========================
    // GRUPOS
    // =========================

    match /grupos/{grupoId} {

      allow read: if usuarioActivo();

      // Solo admin puede tocar grupos.
      allow write: if esAdmin();
    }


    // =========================
    // PAGOS
    // =========================

    match /pagos/{pagoId} {

      // Instructor NO debe ver pagos.
      // Solo admin y recepción.
      allow read: if esAdminORecepcion();

      // Admin y recepción pueden registrar
      // un pago nuevo.
      allow create: if esAdminORecepcion();

      // Solo admin puede editar o eliminar
      // uno ya registrado.
      allow update, delete: if esAdmin();
    }


    // =========================
    // HISTORIAL DE AJUSTES A PAGOS
    // =========================

    match /pagos_historial/{historialId} {

      // Mismo público que puede ver pagos.
      allow read: if esAdminORecepcion();

      // Solo admin puede crear auditoría.
      allow create: if esAdmin();

      // Una vez creado, nadie lo toca.
      allow update, delete: if false;
    }


    // =========================
    // DIRECTORIO NFC
    // =========================

    match /directorio_nfc/{nfcUid} {

      // El kiosco puede consultar una tarjeta.
      allow get: if request.auth != null;

      // Solo staff activo puede listar el directorio.
      allow list: if usuarioActivo();

      // Solo admin/recepción lo mantienen.
      allow write: if esAdminORecepcion();
    }


    // =========================
    // ASISTENCIAS
    // =========================

    match /asistencias/{asistenciaId} {

      // Instructor sí puede ver asistencias.
      allow read: if usuarioActivo();

      // Dos caminos para crear:
      //
      // 1. Kiosco:
      //    origen = kiosco
      //    fecha = request.time
      //
      // 2. Staff:
      //    origen = manual
      //    cualquier fecha válida
      //
      // No se permiten campos adicionales.

      allow create: if request.resource.data.alumnoId is string
                     && exists(
                          /databases/$(database)/documents/alumnos/$(request.resource.data.alumnoId)
                        )
                     && request.resource.data.keys().hasOnly([
                          "alumnoId",
                          "nombre",
                          "fecha",
                          "origen"
                        ])
                     && (
                          (
                            request.auth != null
                            && request.resource.data.origen == "kiosco"
                            && request.resource.data.fecha == request.time
                          )
                          ||
                          (
                            usuarioActivo()
                            && request.resource.data.origen == "manual"
                          )
                        );

      // La edición y eliminación de asistencias
      // queda reservada al admin.
      allow update, delete: if esAdmin();
    }


    // =========================================================
    // NUEVO MÓDULO DE OPERACIONES
    // =========================================================


    // =========================
    // TAREAS
    // =========================

    match /tareas/{tareaId} {

      // Todo usuario activo puede consultar tareas.
      allow read: if usuarioActivo();


      // ---------------------------------
      // CREAR
      // ---------------------------------

      // Admin y recepción pueden crear tareas.
      allow create: if esAdminORecepcion();


      // ---------------------------------
      // ACTUALIZAR
      // ---------------------------------

      // Admin puede modificar cualquier campo.
      allow update: if esAdmin();


      // Recepción puede modificar únicamente
      // los campos operativos de una tarea
      // que tiene asignada.
      //
      // NO puede cambiar:
      // - responsable
      // - creador
      // - origen
      // - alumno relacionado
      // - examen relacionado
      // - etc.

      allow update: if esAdminORecepcion()
                    && resource.data.responsableId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           "estado",
                           "completadoEn"
                         ]);


      // Profesor puede únicamente completar
      // una tarea que le fue asignada.
      //
      // Tampoco puede reasignarla ni modificar
      // su información estructural.

      allow update: if esProfesor()
                    && resource.data.responsableId == request.auth.uid
                    && request.resource.data.responsableId == resource.data.responsableId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           "estado",
                           "completadoEn"
                         ]);


      // Solo admin puede eliminar tareas.
      allow delete: if esAdmin();
    }


    // =========================
    // CLASES DE PRUEBA
    // =========================

    match /clases_prueba/{clasePruebaId} {

      // Todo usuario activo puede consultar clases de prueba.
      allow read: if usuarioActivo();


      // Admin y recepción pueden crear nuevas clases.
      allow create: if esAdminORecepcion();


      // Admin puede modificar cualquier campo.
      allow update: if esAdmin();


      // Recepción puede modificar la información
      // administrativa de una clase de prueba.
      //
      // Se evita que cambie información histórica
      // de quién impartió la clase o quién la creó.

      allow update: if esAdminORecepcion()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           "nombre",
                           "edad",
                           "contacto",
                           "grupo",
                           "fecha",
                           "profesorId",
                           "profesorNombre",
                           "asistio",
                           "resultadoClase",
                           "observaciones",
                           "recomendacion",
                           "estado",
                           "ultimaFechaContacto",
                           "proximaFechaSeguimiento"
                         ]);


      // El profesor puede registrar el resultado
      // de una clase que tiene asignada.
      //
      // No puede cambiar:
      // - nombre
      // - contacto
      // - fecha
      // - profesor asignado
      // - creador
      // - etc.

      allow update: if esProfesor()
                    && resource.data.profesorId == request.auth.uid
                    && request.resource.data.profesorId == resource.data.profesorId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           "asistio",
                           "resultadoClase",
                           "observaciones",
                           "recomendacion",
                           "estado"
                         ]);


      // Solo admin puede eliminar el historial.
      allow delete: if esAdmin();
    }


    // =========================
    // SEGUIMIENTOS
    // =========================

    match /seguimientos/{seguimientoId} {

      // Todo usuario activo puede consultar seguimientos.
      allow read: if usuarioActivo();


      // Admin y recepción pueden crear seguimientos.
      allow create: if esAdminORecepcion();


      // Admin puede modificar cualquier seguimiento.
      allow update: if esAdmin();


      // Recepción puede actualizar únicamente
      // la parte operativa de un seguimiento
      // que tiene asignado.

      allow update: if esAdminORecepcion()
                    && resource.data.responsableId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly([
                           "fecha",
                           "resultado",
                           "notas",
                           "proximaFecha"
                         ]);


      // Solo admin puede eliminar historial.
      allow delete: if esAdmin();
    }


    // =========================
    // EVENTOS
    // =========================

    match /eventos/{eventoId} {

      // Todo el staff puede consultar eventos.
      allow read: if usuarioActivo();

      // Solo admin crea, modifica y elimina eventos.
      allow write: if esAdmin();
    }


    // =========================
    // EXÁMENES
    // =========================

    match /examenes/{examenId} {

      // Todo usuario activo puede consultar exámenes.
      allow read: if usuarioActivo();

      // Solo admin controla el proceso de exámenes.
      allow write: if esAdmin();
    }


    // =========================
    // TODO LO DEMÁS
    // =========================

    // Todo lo que no esté declarado
    // explícitamente arriba queda bloqueado.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}